# AWS Amplify Configuration
# These values will be auto-generated after running `npx ampx sandbox` or deploying

# Cognito User Pool
NEXT_PUBLIC_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_IDENTITY_POOL_ID=us-east-1:XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# API Configuration
NEXT_PUBLIC_API_ENDPOINT=https://XXXXXXXXXX.appsync-api.us-east-1.amazonaws.com/graphql
NEXT_PUBLIC_AWS_REGION=us-east-1

# S3 Storage
NEXT_PUBLIC_STORAGE_BUCKET=riglanpublications-XXXXXXXXXX-XXXX

# Stripe (for future payment integration)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX
# STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX